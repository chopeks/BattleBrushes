	/usr/lib/qt5/bin/moc $(DEFINES) --include /home/poss/Documents/Code/Tiled/build/moc/moc_predefs.h -I/usr/lib/x86_64-linux-gnu/qt5/mkspecs/linux-g++ -I/home/poss/Documents/Code/Tiled -I/home/poss/Documents/Code/Tiled/mock_tiled_headers -I/home/poss/Documents/Code/Tiled/tiled/src/plugins/brush -I/usr/include/x86_64-linux-gnu/qt5 -I/usr/include/x86_64-linux-gnu/qt5/QtWidgets -I/usr/include/x86_64-linux-gnu/qt5/QtGui -I/usr/include/x86_64-linux-gnu/qt5/QtCore -I/usr/include/c++/11 -I/usr/include/x86_64-linux-gnu/c++/11 -I/usr/include/c++/11/backward -I/usr/lib/gcc/x86_64-linux-gnu/11/include -I/usr/local/include -I/usr/include/x86_64-linux-gnu -I/usr/include mock_tiled_headers/plugin.h -o build/moc/moc_plugin.cpp

