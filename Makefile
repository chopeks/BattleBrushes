####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/home/poss/Documents/Code/Tiled/./plugins || mkdir -p $(INSTALL_ROOT)/home/poss/Documents/Code/Tiled/./plugins
	$(QINSTALL_PROGRAM) build/$(TARGET) $(INSTALL_ROOT)/home/poss/Documents/Code/Tiled/plugins/$(TARGET)
	-$(STRIP) --strip-unneeded $(INSTALL_ROOT)/home/poss/Documents/Code/Tiled/plugins/$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/home/poss/Documents/Code/Tiled/plugins/$(TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/home/poss/Documents/Code/Tiled/./plugins/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

